# Runtime connection (production: pooled URL)
DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger"
# Prisma CLI / migrations (production: direct URL)
DIRECT_DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger"
# Integration tests
TEST_DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger_test"

# --- 아래 두 값은 .env.local에 둔다 (docker compose가 .env의 $를 변수로 해석하지 않도록) ---
ADMIN_USERNAME="admin"
# generate with npm run hash-password (password: 12+ chars, max 72 bytes). Next expands $VAR in .env: escape every $ as \$ (e.g. \$2b\$12\$...)
ADMIN_PASSWORD_HASH="replace-me"
